generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL is used by `prisma migrate` and `prisma db push` so they bypass
  // PgBouncer (which doesn't support some migration statements). At runtime,
  // Prisma uses DATABASE_URL — point that at the Supabase transaction pooler
  // (port 6543) with ?pgbouncer=true&connection_limit=1.
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum CompanyRole {
  ADMIN
  MANAGER
  MEMBER
}

enum CycleStatus {
  DRAFT
  NOMINATION
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum ReviewAssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum NominationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewerType {
  SELF
  MANAGER
  PEER
  DIRECT_REPORT
  EXTERNAL
}

enum QuestionType {
  RATING
  TEXT
  COMPETENCY_RATING
  MULTIPLE_CHOICE
}

enum AccessTokenPurpose {
  EMPLOYEE_PORTAL
  COMPLETE_REVIEW
}

// Climate Survey enums
enum ClimateSurveyType {
  CLIMATE
  PULSE
  ENPS
  LEADERSHIP
  CULTURE
  PERFORMANCE
}

enum ClimateSurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SurveyQuestionType {
  LIKERT
  TEXT
  NPS
  RATING
}

enum SurveyTargetType {
  ALL
  HUB
  DEPARTMENT
  TEAM
  CUSTOM
}

enum TeamRole {
  LEAD
  MEMBER
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

// Interpretation bands of the validated climate instrument (mean on 1–4)
enum ClimateBand {
  MUY_DESFAVORABLE
  DESFAVORABLE
  FAVORABLE
  MUY_FAVORABLE
}

enum ActionPlanScope {
  LEADER
  DEPARTMENT
  HUB
  TEAM
  ORGANIZATION
}

enum ActionPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ActionTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ActionMeasureKind {
  OUTCOME
  PROCESS
}

enum SurveyFrequency {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

// ============================================
// CORE ENTITIES
// ============================================

model Company {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logo         String?
  primaryColor String?  @default("#0066FF")
  domain       String?
  // Tax/legal identifier (NIT in Colombia, VAT/EIN elsewhere). Required at
  // the DB layer (NOT NULL, no default) — every insert must supply a value.
  // Format validation lives in Zod; legacy rows from before this column
  // existed were backfilled with the sentinel "PENDING".
  taxId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Locale
  locale String @default("es")

  // Feature flags
  featureAts        Boolean @default(false)
  featureOnboarding Boolean @default(false)
  featureWorkEnv    Boolean @default(true)
  featureHubs       Boolean @default(false)

  users        CompanyUser[]
  employees    Employee[]
  departments  Department[]
  hubs         Hub[]
  teams        Team[]
  templates    Template[]
  cycles       Cycle[]
  invitations  Invitation[]
  tokens       ReviewToken[]
  roleConfigs  CompanyRoleConfig[]
  accessTokens AccessToken[]

  // Climate surveys
  climateSurveys          ClimateSurvey[]
  climateDimensions       ClimateDimension[]
  climateSurveyTemplates  ClimateSurveyTemplate[]
  actionPlans             ActionPlan[]

  @@index([slug])
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  firstName     String?
  lastName      String?
  phone         String?
  image         String?
  globalRole    GlobalRole @default(USER)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts  Account[]
  sessions  Session[]
  companies CompanyUser[]

  @@index([email])
}

model Employee {
  id           String    @id @default(cuid())
  companyId    String
  email        String
  name         String
  title        String?
  employeeCode String?
  managerId    String?
  departmentId String?
  startDate    DateTime?
  isActive     Boolean   @default(true)
  // Demographics for climate segments (optional; never shown per person)
  gender       Gender?
  birthDate    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hubId        String?

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager       Employee?   @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports Employee[]  @relation("EmployeeManager")
  department    Department? @relation(fields: [departmentId], references: [id])
  hub           Hub?        @relation(fields: [hubId], references: [id])

  companyUser CompanyUser?

  cycleParticipations CycleParticipant[]
  reviewsGiven        ReviewAssignment[] @relation("ReviewerAssignments")
  reviewsReceived     ReviewAssignment[] @relation("RevieweeAssignments")
  nominationsGiven    Nomination[]       @relation("NominatorRelation")
  nominationsReceived Nomination[]       @relation("NomineeRelation")
  nominationsFor      Nomination[]       @relation("RevieweeNominations")
  accessTokens        AccessToken[]
  surveyResponses     SurveyResponse[]
  teamMemberships     TeamMember[]
  ownedActionPlans    ActionPlan[]          @relation("ActionPlanOwner")
  actionTasks         ActionPlanTask[]      @relation("ActionTaskOwner")
  leaderContexts      LeaderSurveyContext[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([managerId])
  @@index([departmentId])
  @@index([hubId])
}

model CompanyUser {
  id           String      @id @default(cuid())
  userId       String
  companyId    String
  role         CompanyRole @default(MEMBER)
  roleConfigId String?
  employeeId   String?     @unique
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleConfig CompanyRoleConfig? @relation(fields: [roleConfigId], references: [id])
  employee   Employee?         @relation(fields: [employeeId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  employees Employee[]
  teams     Team[]

  @@index([companyId])
  @@index([parentId])
}

// ============================================
// HUBS & TEAMS
// ============================================

model Hub {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  companyId   String
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  teams     Team[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Team {
  id           String   @id @default(cuid())
  name         String
  description  String?
  companyId    String
  hubId        String?
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hub        Hub?        @relation(fields: [hubId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  members    TeamMember[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([hubId])
  @@index([departmentId])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  employeeId String
  role       TeamRole @default(MEMBER)
  joinedAt   DateTime @default(now())

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
}

// ============================================
// TEMPLATES
// ============================================

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  companyId   String?
  isDefault   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections TemplateSection[]
  cycles   Cycle[]

  @@index([companyId])
}

model TemplateSection {
  id            String         @id @default(cuid())
  templateId    String
  title         String
  description   String?
  order         Int
  reviewerTypes ReviewerType[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  template  Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions TemplateQuestion[]

  @@index([templateId])
}

model TemplateQuestion {
  id           String       @id @default(cuid())
  sectionId    String
  text         String
  description  String?
  type         QuestionType
  isRequired   Boolean      @default(true)
  order        Int
  config       Json?
  competencyId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  section    TemplateSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  competency Competency?      @relation(fields: [competencyId], references: [id])
  responses  ReviewResponse[]

  @@index([sectionId])
}

model Competency {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions TemplateQuestion[]

  @@index([companyId])
}

// ============================================
// REVIEW CYCLES
// ============================================

model Cycle {
  id          String      @id @default(cuid())
  name        String
  description String?
  companyId   String
  templateId  String
  status      CycleStatus @default(DRAFT)

  nominationStartDate DateTime?
  nominationEndDate   DateTime?
  reviewStartDate     DateTime
  reviewEndDate       DateTime
  reportReleaseDate   DateTime?

  selfReviewEnabled    Boolean @default(true)
  managerReviewEnabled Boolean @default(true)
  peerReviewEnabled    Boolean @default(true)
  directReportEnabled  Boolean @default(false)
  externalEnabled      Boolean @default(false)

  minPeers           Int @default(3)
  maxPeers           Int @default(8)
  anonymityThreshold Int @default(3)

  employeeNominatePeers Boolean @default(true)
  managerApprovePeers   Boolean @default(true)

  scope    SurveyTargetType @default(CUSTOM)
  scopeIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template     Template           @relation(fields: [templateId], references: [id])
  participants CycleParticipant[]
  nominations  Nomination[]
  assignments  ReviewAssignment[]

  @@index([companyId])
  @@index([status])
}

model CycleParticipant {
  id         String    @id @default(cuid())
  cycleId    String
  employeeId String
  isReviewee Boolean   @default(true)
  isReviewer Boolean   @default(true)
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  cycle    Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
}

model Nomination {
  id              String           @id @default(cuid())
  cycleId         String
  nominatorId     String
  nomineeId       String
  revieweeId      String
  reviewerType    ReviewerType
  status          NominationStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  cycle     Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  nominator Employee @relation("NominatorRelation", fields: [nominatorId], references: [id])
  nominee   Employee @relation("NomineeRelation", fields: [nomineeId], references: [id])
  reviewee  Employee @relation("RevieweeNominations", fields: [revieweeId], references: [id])

  @@unique([cycleId, nomineeId, revieweeId])
  @@index([cycleId])
  @@index([status])
}

// ============================================
// REVIEWS
// ============================================

model ReviewAssignment {
  id                String                 @id @default(cuid())
  cycleId           String
  reviewerId        String?
  revieweeId        String
  reviewerType      ReviewerType
  status            ReviewAssignmentStatus @default(PENDING)
  externalEmail     String?
  externalName      String?
  tokenId           String?                @unique
  declineReason     String?
  startedAt         DateTime?
  completedAt       DateTime?
  lastSavedAt       DateTime?
  draftResponses    Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  cycle     Cycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewer  Employee?         @relation("ReviewerAssignments", fields: [reviewerId], references: [id])
  reviewee  Employee          @relation("RevieweeAssignments", fields: [revieweeId], references: [id])
  token     ReviewToken?      @relation(fields: [tokenId], references: [id])
  responses ReviewResponse[]

  @@unique([cycleId, reviewerId, revieweeId])
  @@index([cycleId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([status])
}

model ReviewResponse {
  id              String   @id @default(cuid())
  assignmentId    String
  questionId      String
  ratingValue     Int?
  textValue       String?
  selectedOptions String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignment ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   TemplateQuestion @relation(fields: [questionId], references: [id])

  @@unique([assignmentId, questionId])
  @@index([assignmentId])
}

// ============================================
// TOKEN-BASED ACCESS
// ============================================

model ReviewToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  name      String?
  companyId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignment ReviewAssignment?

  @@index([token])
  @@index([email])
}

model AccessToken {
  id         String             @id @default(cuid())
  token      String             @unique
  email      String
  companyId  String
  employeeId String?
  purpose    AccessTokenPurpose
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime           @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([token])
  @@index([email])
}

// ============================================
// INVITATIONS
// ============================================

model Invitation {
  id           String      @id @default(cuid())
  email        String
  companyId    String
  role         CompanyRole @default(MEMBER)
  roleConfigId String?
  departmentId String?
  managerId    String?
  hubId        String?
  token        String      @unique @default(cuid())
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())

  // Pre-filled invitee profile data — populated when a SUPER_ADMIN invites
  // a new tenant's first ADMIN through the create-account flow. acceptInvitation
  // seeds these onto the new User + Employee rows; the invitee can edit later
  // from /settings/profile. Null for regular member invites.
  inviteeFirstName String?
  inviteeLastName  String?
  inviteePhone     String?
  inviteeJobTitle  String?

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleConfig CompanyRoleConfig? @relation(fields: [roleConfigId], references: [id])

  @@unique([email, companyId])
  @@index([token])
}

// ============================================
// COMPANY ROLE CONFIGURATION
// ============================================

model CompanyRoleConfig {
  id          String       @id @default(cuid())
  companyId   String
  slug        String
  name        String
  description String?
  baseRole    CompanyRole?
  isSystem    Boolean      @default(false)
  permissions Json         @default("{}")
  color       String?      @default("#6b7280")
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     CompanyUser[]
  invitations Invitation[]

  @@unique([companyId, slug])
  @@index([companyId])
}

// ============================================
// CLIMATE SURVEYS (WORK ENVIRONMENT)
// ============================================

model ClimateSurveyTemplate {
  id          String            @id @default(cuid())
  name        String
  description String?
  companyId   String?
  type        ClimateSurveyType @default(CLIMATE)
  isDefault   Boolean           @default(false)
  isArchived  Boolean           @default(false)
  // Set on the validated Kultiva instrument (e.g. "KCO-2026.1")
  instrumentVersion String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company?                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions ClimateSurveyTemplateQuestion[]
  surveys   ClimateSurvey[]

  @@index([companyId])
}

model ClimateSurveyTemplateQuestion {
  id          String             @id @default(cuid())
  templateId  String
  dimensionId String?
  text        String
  type        SurveyQuestionType
  order       Int
  isRequired  Boolean            @default(true)
  config      Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  template  ClimateSurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dimension ClimateDimension?     @relation(fields: [dimensionId], references: [id])

  @@index([templateId])
}

model ClimateSurvey {
  id          String              @id @default(cuid())
  name        String
  description String?
  companyId   String
  templateId  String?
  type        ClimateSurveyType   @default(CLIMATE)
  status      ClimateSurveyStatus @default(DRAFT)
  frequency   SurveyFrequency     @default(ONCE)
  isAnonymous Boolean             @default(true)

  // Minimum respondents required before a segment's results are shown in
  // aggregations. Protects individual privacy: a department with <N replies
  // gets its dimension scores hidden so individuals can't be inferred.
  // Industry standard for climate surveys is 5; smaller orgs may use 3.
  anonymityThreshold Int @default(5)

  // Welcome page customization (shown to respondents before the form)
  welcomeTitle     String?
  welcomeBody      String?
  welcomeBannerUrl String?
  welcomeCtaText   String?
  themeColor       String?

  // Wallpaper configuration (JSON — controls the welcome page header/background)
  wallpaperConfig  Json?
  // Color scheme (JSON — background, buttons, buttonText, pageText, titleText)
  colorConfig      Json?
  // Questions per page: null or 0 = all on one page, >0 = paginated
  questionsPerPage Int?

  // Thank-you page customization (shown to respondents after submission)
  thankYouTitle    String?
  thankYouBody     String?
  thankYouCtaText  String?

  // Branding
  logoUrl          String?

  // Access control
  accessStartDate  DateTime?
  accessEndDate    DateTime?

  // Scoring & action plans (docs/climate-scoring-and-action-plans-spec.md)
  // Copied from the template; scores only compare across the same version.
  instrumentVersion String?
  // A dimension or group "has a gap" when its band is below this one.
  goalBand          ClimateBand @default(FAVORABLE)
  planMinPerLeader  Int         @default(1)
  planDueDate       DateTime?
  // Leaders see their team results (and can plan) only after release.
  resultsReleasedAt DateTime?
  // User ids notified about plans (HR / seguimiento)
  followUpUserIds   String[]    @default([])
  // Last "plans due soon" reminder sent to leaders (once per survey)
  planReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template       ClimateSurveyTemplate? @relation(fields: [templateId], references: [id])
  questions      SurveyQuestion[]
  distributions  SurveyDistribution[]
  actionPlans    ActionPlan[]
  leaderContexts LeaderSurveyContext[]

  @@index([companyId])
  @@index([status])
}

model ClimateDimension {
  id          String   @id @default(cuid())
  name        String
  description String?
  companyId   String?
  icon        String?
  order       Int      @default(0)
  isDefault   Boolean  @default(false)
  // Stable code for instrument dimensions (e.g. "LID")
  code        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company           Company?                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions         SurveyQuestion[]
  templateQuestions  ClimateSurveyTemplateQuestion[]
  actionPlans       ActionPlan[]

  @@unique([companyId, name])
  @@index([companyId])
}

model SurveyQuestion {
  id          String             @id @default(cuid())
  surveyId    String
  dimensionId String?
  text        String
  type        SurveyQuestionType
  order       Int
  isRequired  Boolean            @default(true)
  config      Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  survey    ClimateSurvey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  dimension ClimateDimension? @relation(fields: [dimensionId], references: [id])
  answers   SurveyAnswer[]

  @@index([surveyId])
}

model SurveyDistribution {
  id              String           @id @default(cuid())
  surveyId        String
  targetType      SurveyTargetType @default(ALL)
  targetIds       String[]
  sentAt          DateTime?
  dueDate         DateTime
  reminderSentAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  survey    ClimateSurvey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([surveyId])
}

model SurveyResponse {
  id             String    @id @default(cuid())
  distributionId String
  employeeId     String?
  submittedAt    DateTime?
  isComplete     Boolean   @default(false)
  // Respondent's org position at submission ({ departmentId, hubId, teamIds,
  // leaderEmployeeId }) so later reorganizations don't rewrite results.
  segmentSnapshot Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  distribution SurveyDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  employee     Employee?          @relation(fields: [employeeId], references: [id])
  answers      SurveyAnswer[]

  @@unique([distributionId, employeeId])
  @@index([distributionId])
  @@index([employeeId])
}

model SurveyAnswer {
  id          String   @id @default(cuid())
  responseId  String
  questionId  String
  ratingValue Int?
  textValue   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  // Cascade so deleting a survey (or its company) with answers doesn't fail
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId])
}

// ============================================
// CLIMATE ACTION PLANS
// ============================================

model ActionPlan {
  id              String           @id @default(cuid())
  companyId       String
  // Source survey whose results the plan responds to
  surveyId        String
  dimensionId     String
  scope           ActionPlanScope
  // employeeId (LEADER), departmentId, hubId or teamId; null for ORGANIZATION
  scopeRefId      String?
  ownerEmployeeId String
  title           String
  objective       String

  // Baseline snapshot from the source survey — never recomputed
  baselineMean         Float
  baselineFavorability Float?
  baselineBand         ClimateBand
  baselineN            Int

  targetBand ClimateBand
  targetMean Float?
  startDate  DateTime
  endDate    DateTime

  status       ActionPlanStatus @default(DRAFT)
  submittedAt  DateTime?
  closingNote  String?
  completedAt  DateTime?
  cancelReason String?

  createdByUserId     String?
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  survey    ClimateSurvey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  // NO ACTION (checked at statement end) lets a company delete cascade through
  // plans, while deleting an employee or dimension that still has plans fails.
  dimension ClimateDimension    @relation(fields: [dimensionId], references: [id], onDelete: NoAction)
  owner     Employee            @relation("ActionPlanOwner", fields: [ownerEmployeeId], references: [id], onDelete: NoAction)
  tasks     ActionPlanTask[]
  measures  ActionPlanMeasure[]
  updates   ActionPlanUpdate[]

  @@index([companyId])
  @@index([surveyId, scope, scopeRefId])
  @@index([ownerEmployeeId])
}

model ActionPlanTask {
  id                  String           @id @default(cuid())
  planId              String
  title               String
  description         String?
  ownerEmployeeId     String?
  dueDate             DateTime
  status              ActionTaskStatus @default(PENDING)
  completedAt         DateTime?
  order               Int              @default(0)
  // Set when picked from the suggested-actions library
  suggestedActionCode String?
  // Last due-soon/overdue reminder (at most one per day)
  reminderSentAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  plan     ActionPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  owner    Employee?            @relation("ActionTaskOwner", fields: [ownerEmployeeId], references: [id])
  evidence ActionPlanEvidence[]
  updates  ActionPlanUpdate[]
  measures ActionPlanMeasure[]

  @@index([planId])
  @@index([ownerEmployeeId, status])
}

model ActionPlanMeasure {
  id            String            @id @default(cuid())
  planId        String
  // PROCESS measures may belong to a task
  taskId        String?
  kind          ActionMeasureKind
  name          String
  unit          String?
  baselineValue Float?
  targetValue   Float?
  currentValue  Float?

  // OUTCOME evaluation (filled when a follow-up survey closes)
  followUpSurveyId   String?
  resultMean         Float?
  resultFavorability Float?
  resultBand         ClimateBand?
  resultN            Int?
  evaluatedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan    ActionPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  task    ActionPlanTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updates ActionPlanUpdate[]

  @@index([planId])
}

model ActionPlanUpdate {
  id               String   @id @default(cuid())
  planId           String
  taskId           String?
  measureId        String?
  authorEmployeeId String?
  authorUserId     String?
  authorName       String
  note             String
  // New currentValue of a PROCESS measure
  value            Float?
  statusFrom       String?
  statusTo         String?
  createdAt        DateTime @default(now())

  plan    ActionPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  task    ActionPlanTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  measure ActionPlanMeasure? @relation(fields: [measureId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

model ActionPlanEvidence {
  id                   String   @id @default(cuid())
  taskId               String
  fileName             String
  mimeType             String
  sizeBytes            Int
  // Path in the private evidence bucket; served through signed URLs
  storagePath          String
  uploadedByEmployeeId String?
  uploadedByUserId     String?
  createdAt            DateTime @default(now())

  task ActionPlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// A leader's optional reflection about their team before planning
model LeaderSurveyContext {
  id               String   @id @default(cuid())
  surveyId         String
  leaderEmployeeId String
  // { q1, q2, q3, q4 }
  answers          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  survey ClimateSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  leader Employee      @relation(fields: [leaderEmployeeId], references: [id], onDelete: Cascade)

  @@unique([surveyId, leaderEmployeeId])
}

// ============================================
// SUPER ADMIN DOMAINS
// ============================================

model SuperAdminDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // e.g. "kultiva.com.co"
  createdAt DateTime @default(now())
}

// ============================================
// NEXTAUTH REQUIRED MODELS
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
