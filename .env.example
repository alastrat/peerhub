# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peerhub?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth Providers (optional for MVP)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="PeerHub <noreply@peerhub.com>"

# For local development without Resend, emails are logged to console
# Set to "true" to use console logging instead of Resend
EMAIL_DEV_MODE="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PeerHub"

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
SANITY_WEBHOOK_SECRET=""

# Sentry (frontend + backend error monitoring)
# DSN is required to enable Sentry; leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=""
# Org/project + auth token are only needed at build time to upload source maps
# (set these on CI / Vercel, not locally).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
