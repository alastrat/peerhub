# Database
# Local dev: a single Postgres URL is fine.
# On Supabase / Vercel: point DATABASE_URL at the *transaction pooler*
# (port 6543) with `?pgbouncer=true&connection_limit=1`, and set DIRECT_URL
# to the *session pooler* (port 5432) for migrations. Mixing them up causes
# `EMAXCONNSESSION` errors under serverless load.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peerhub?schema=public"
DIRECT_URL=""

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth Providers (optional for MVP)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="PeerHub <noreply@peerhub.com>"

# For local development without Resend, emails are logged to console
# Set to "true" to use console logging instead of Resend
EMAIL_DEV_MODE="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PeerHub"

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
SANITY_WEBHOOK_SECRET=""

# Supabase Storage (for survey logo uploads)
# The same Supabase project that hosts the database also stores assets.
# Create a public bucket named "survey-assets" in the Supabase dashboard,
# then set these values. Service role key goes server-only — never expose
# it to the client.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Sentry (frontend + backend error monitoring)
# Public DSN — required to enable client-side Sentry; leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional server-side DSN override; falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=""
# Org/project + auth token are only needed at build time to upload source maps
# (set these on CI / Vercel, not locally).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
